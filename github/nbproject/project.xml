            <class-path-extension>
                <runtime-relative-path>ext/commons-lang3-3.18.0.jar</runtime-relative-path>
                <binary-origin>release/modules/ext/commons-lang3-3.18.0.jar</binary-origin>
            </class-path-extension>
            <class-path-extension>
                <runtime-relative-path>ext/github-api-1.330.jar</runtime-relative-path>
